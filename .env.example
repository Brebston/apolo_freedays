# ---------------------------------------------------------------------------
# Apolo — environment variables. Copy to .env and fill in.
# Full descriptions: README.md → Configuration
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me          # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=1                       # 1 = local development, 0 = production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_BASE_URL=http://localhost:8000  # public URL used in email links

# PostgreSQL (in Docker Compose the host is "db")
POSTGRES_DB=absence_bot
POSTGRES_USER=absence_bot
POSTGRES_PASSWORD=absence_bot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery (in Docker Compose the host is "redis")
REDIS_URL=redis://redis:6379/0

# Telegram
BOT_TOKEN=123456:your-bot-token
WEBAPP_URL=                          # e.g. https://domainname.domain/app/ — empty locally
WEBAPP_DEV_TELEGRAM_ID=              # your Telegram ID, only with DJANGO_DEBUG=1

# Email (Resend)
RESEND_API_KEY=re_your_api_key
DEFAULT_FROM_EMAIL=Apolo <notifications@domainname.domain>

# Error monitoring (optional — Sentry is off when empty)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Sick leave (optional, defaults shown)
SICK_NOTE_REMINDER_AFTER_DAYS=2
SICK_NOTE_REMINDER_INTERVAL_DAYS=2
SICK_NOTE_REMINDER_MAX=3
SICK_LEAVE_FILE_RETENTION_DAYS=90
